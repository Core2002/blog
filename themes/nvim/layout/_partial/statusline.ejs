<%
  const branch = (theme.repo && theme.repo.branch) || 'src';
  const repoLink = (theme.repo && theme.repo.url)
    ? theme.repo.url.replace(/\.git$/, '') + '/tree/' + branch
    : ((theme.social && theme.social.github) || '');
%>
<footer class="statusline" aria-label="状态栏">
  <span class="status-progress" aria-hidden="true"><span id="status-progress-bar"></span></span>

  <div class="status-left">
    <span class="sl-mode" id="sl-mode">NORMAL</span>
    <% if (repoLink) { %>
      <a class="sl-seg sl-branch" href="<%= repoLink %>" target="_blank" rel="noopener noreferrer" title="源码仓库分支">
        <i class="i i-git" aria-hidden="true"></i><span><%= branch %></span>
      </a>
    <% } else { %>
      <span class="sl-seg sl-branch"><i class="i i-git" aria-hidden="true"></i><span><%= branch %></span></span>
    <% } %>
    <span class="sl-seg sl-file">
      <i class="i i-file-md" aria-hidden="true"></i>
      <span id="sl-file"><%= fileBase %></span>
      <span class="sl-mod" title="modified">●</span>
    </span>
  </div>

  <div class="status-right">
    <span class="sl-seg sl-ft"><%= fileKind %></span>
    <span class="sl-seg sl-enc">utf-8</span>
    <span class="sl-seg sl-eol">unix</span>
    <span class="sl-seg sl-pct" id="sl-percent" title="阅读进度">TOP</span>
    <span class="sl-seg sl-clock" id="sl-clock">00:00</span>
  </div>
</footer>
