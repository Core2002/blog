<%
  const friends = site.data && site.data.friends ? site.data.friends : [];
  const total = friends.length;
%>
<article class="friends">
  <header class="page-head">
    <div class="post-kicker"><span class="c">--</span><span>friends.json</span><span class="c">--</span></div>
    <h1 class="page-title"><span class="md-hash">#</span>友链</h1>
    <p class="page-desc"><%= total %> 个邻居，散落在互联网的不同角落。</p>
  </header>

  <% if (!total) { %>
    <div class="empty-state">
      <span class="empty-prompt">~</span>
      <p>还没有友链。在 <code>source/_data/friends.json</code> 中添加。</p>
    </div>
  <% } else { %>
    <div class="friends-grid">
      <% friends.forEach(function (friend, i) { %>
        <a class="friend-card" href="<%= friend.url %>" target="_blank" rel="noopener noreferrer">
          <span class="friend-index"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="friend-avatar-wrap">
            <% if (friend.avatar) { %>
              <img class="friend-avatar" src="<%= friend.avatar %>" alt="" loading="lazy" width="44" height="44" referrerpolicy="no-referrer">
            <% } else { %>
              <span class="friend-avatar friend-avatar-fallback"><%= (friend.name || '?').slice(0, 1) %></span>
            <% } %>
          </span>
          <span class="friend-body">
            <span class="friend-name"><%= friend.name %><i class="i i-external friend-ext" aria-hidden="true"></i></span>
            <span class="friend-intro"><%= friend.introduction || '' %></span>
            <span class="friend-url"><%= (friend.url || '').replace(/^https?:\/\//, '').replace(/\/$/, '') %></span>
          </span>
        </a>
      <% }); %>
    </div>
  <% } %>

  <div class="friends-note">
    <span class="c">//</span> 想交换友链？去 <a href="<%= url_for('/contact/') %>">联系页</a> 找我。
  </div>
</article>
