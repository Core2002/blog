<%
  const social = theme.social || {};
  const profile = theme.profile || {};
  const items = [
    { key: 'github', label: 'GitHub', value: social.github ? social.github.replace(/^https?:\/\//, '') : '', icon: 'i-github', url: social.github },
    { key: 'email', label: 'Email', value: social.email || '', icon: 'i-envelope', url: social.email ? 'mailto:' + social.email : '' },
    { key: 'bilibili', label: 'Bilibili', value: social.bilibili ? social.bilibili.replace(/^https?:\/\//, '') : '', icon: 'i-link', url: social.bilibili },
    { key: 'zhihu', label: '知乎', value: social.zhihu ? social.zhihu.replace(/^https?:\/\//, '') : '', icon: 'i-link', url: social.zhihu }
  ].filter(function (i) { return i.url; });
%>
<article class="contact">
  <header class="page-head">
    <div class="post-kicker"><span class="c">--</span><span>contact</span><span class="c">--</span></div>
    <h1 class="page-title"><span class="md-hash">#</span>联系</h1>
    <p class="page-desc">找一个能收到消息的地方。</p>
  </header>

  <div class="terminal-window" aria-label="联系方式">
    <div class="terminal-bar">
      <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="terminal-title">contact — ~/blog</span>
      <span class="terminal-shell">sh</span>
    </div>
    <pre class="terminal-body"><span class="t-prompt">$</span> contact --list<% if (!items.length) { %>
<span class="t-out">no public contact</span><% } else { %><% items.forEach(function (item) { %>
<span class="t-key"><%= item.label.toLowerCase().padEnd(9, ' ') %></span><%= item.value %><% }); %><% } %>
<span class="t-prompt">$</span> <span class="terminal-cursor" aria-hidden="true"></span></pre>
  </div>

  <% if (items.length) { %>
    <div class="contact-grid">
      <% items.forEach(function (item) { %>
        <a class="contact-card" href="<%= item.url %>" <%= /^https?:/.test(item.url) ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
          <span class="contact-icon"><i class="i <%= item.icon %>" aria-hidden="true"></i></span>
          <span class="contact-text">
            <span class="contact-label"><%= item.label %></span>
            <span class="contact-value"><%= item.value %></span>
          </span>
          <i class="i i-external contact-arrow" aria-hidden="true"></i>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <div class="notice">
      <i class="i i-info" aria-hidden="true"></i>
      <span>目前没有公开的联系方式。</span>
    </div>
  <% } %>

  <% if (social.github) { %>
    <p class="contact-note">代码与文章都在 <a href="<%= social.github %>" target="_blank" rel="noopener noreferrer">GitHub</a>，issue 也是不错的方式。</p>
  <% } %>
</article>
